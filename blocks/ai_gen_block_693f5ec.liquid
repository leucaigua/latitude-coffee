    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#dea63d"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 40,
