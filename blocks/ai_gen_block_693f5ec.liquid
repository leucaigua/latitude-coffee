{% doc %}
  @prompt
    create a pop-up alert to disclaimer for the pumpkin flavored coffee that it will be available after the first week of September. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-popup-alert-{{ ai_gen_id }} {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-popup-alert-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-popup-alert-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .ai-popup-alert-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-popup-alert-content-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    max-width: {{ block.settings.max_width }}px;
    width: 100%;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    transform: scale(0.9);
    transition: transform 0.3s ease;
  }

  .ai-popup-alert-{{ ai_gen_id }}.active .ai-popup-alert-content-{{ ai_gen_id }} {
    transform: scale(1);
  }

  .ai-popup-alert-close-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.padding | divided_by: 2 }}px;
    right: {{ block.settings.padding | divided_by: 2 }}px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    transition: opacity 0.2s ease;
    z-index: 1;
  }

  .ai-popup-alert-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-popup-alert-icon-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
  }

  .ai-popup-alert-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-popup-alert-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 12px;
    text-align: center;
    font-weight: 600;
  }

  .ai-popup-alert-message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    text-align: center;
    margin: 0 0 20px;
  }

  .ai-popup-alert-button-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 12px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-align: center;
  }

  .ai-popup-alert-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-popup-alert-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.8 }}px;
    }

    .ai-popup-alert-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-popup-alert-message-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<pumpkin-alert-popup-{{ ai_gen_id }}
  class="ai-popup-alert-{{ ai_gen_id }}"
  data-auto-show="{{ block.settings.auto_show }}"
  data-delay="{{ block.settings.delay }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-popup-alert-overlay-{{ ai_gen_id }}"></div>
  <div class="ai-popup-alert-container-{{ ai_gen_id }}">
    <div class="ai-popup-alert-content-{{ ai_gen_id }}">
      <button
        class="ai-popup-alert-close-{{ ai_gen_id }}"
        aria-label="Close alert"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      {% if block.settings.show_icon %}
        <div class="ai-popup-alert-icon-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="ai-popup-alert-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.message != blank %}
        <div class="ai-popup-alert-message-{{ ai_gen_id }}">
          {{ block.settings.message }}
        </div>
      {% endif %}

      <button class="ai-popup-alert-button-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </button>
    </div>
  </div>
</pumpkin-alert-popup-{{ ai_gen_id }}>

<script>
  (function() {
    class PumpkinAlertPopup{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.popup = this;
        this.closeButton = this.querySelector('.ai-popup-alert-close-{{ ai_gen_id }}');
        this.confirmButton = this.querySelector('.ai-popup-alert-button-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-popup-alert-overlay-{{ ai_gen_id }}');
        this.autoShow = this.dataset.autoShow === 'true';
        this.delay = parseInt(this.dataset.delay) || 0;
      }

      connectedCallback() {
        this.setupEventListeners();
        
        if (this.autoShow) {
          setTimeout(() => {
            this.show();
          }, this.delay);
        }
      }

      setupEventListeners() {
        this.closeButton.addEventListener('click', () => this.close());
        this.confirmButton.addEventListener('click', () => this.close());
        this.overlay.addEventListener('click', () => this.close());

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.popup.classList.contains('active')) {
            this.close();
          }
        });
      }

      show() {
        this.popup.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      close() {
        this.popup.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    customElements.define('pumpkin-alert-popup-{{ ai_gen_id }}', PumpkinAlertPopup{{ ai_gen_id }});
  })();
</script>

