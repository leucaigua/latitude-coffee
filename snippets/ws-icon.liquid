{%- comment -%} Wholesale line icons. Usage: {% render 'ws-icon', name: 'handshake' %} {%- endcomment -%}
{%- case name -%}
  {%- when 'handshake' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m11 17 2 2a1 1 0 1 0 3-3"/>
      <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3L15.6 9.6a3 3 0 0 0-4.2 0l-.9.9a1 1 0 0 1-3-3l2.9-2.9a5.3 5.3 0 0 1 7.5 0l.5.4h3.1"/>
      <path d="m21 3 1 11h-2M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3M3 4h8"/>
    </svg>
  {%- when 'bean' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="24" cy="24" rx="13" ry="18" transform="rotate(35 24 24)"/><path d="M15 36c2-8 6-12 9-14s7-6 9-14"/></svg>
  {%- when 'box' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M24 4l18 9v22l-18 9-18-9V13z"/><path d="M6 13l18 9 18-9M24 22v22M15 8.5l18 9"/></svg>
  {%- when 'kcup' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 14h32l-4 26H12z"/><path d="M6 14h36M18 8h12"/></svg>
  {%- when 'grind' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="17"/><path d="M24 7v34M24 7c9 5 9 29 0 34"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h26v20H3zM29 18h9l7 8v6H29"/><circle cx="12" cy="36" r="4"/><circle cx="36" cy="36" r="4"/></svg>
  {%- when 'award' -%}
