  {%- when 'tag' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 24V6h18l22 22-18 18z"/><circle cx="14" cy="16" r="3"/></svg>
  {%- when 'gift' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="18" width="36" height="24" rx="2"/><path d="M4 12h40v6H4zM24 12v30M24 12c-4-8-14-8-12 0M24 12c4-8 14-8 12 0"/></svg>
  {%- when 'flame' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M24 44c-8 0-14-5-14-13 0-9 9-12 9-22 6 4 9 9 9 14 2-2 3-5 3-7 5 4 7 10 7 15 0 8-6 13-14 13z"/></svg>
  {%- when 'cup' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 18h28v10a12 12 0 0 1-12 12h-4A12 12 0 0 1 8 28z"/><path d="M36 21h3a5 5 0 0 1 0 10h-4"/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="24" r="19"/><path d="M15 24l6 6 12-13"/></svg>
