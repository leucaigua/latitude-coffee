{%- comment -%}
  "Fill it with fresh-roasted Latitude" — cross-sell beans from a chosen collection,
  with a free-shipping nudge based on the current product price.
  Replaces the algorithmic "You may also like" on this template.
{%- endcomment -%}
{%- liquid
  assign threshold_cents = section.settings.free_ship_threshold | times: 100
  assign remaining = threshold_cents | minus: product.price
-%}
{%- style -%}
  #cn-pair-{{ section.id }} {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text }};
    padding: {{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px;
  }
  #cn-pair-{{ section.id }} .cn-wrap { max-width: 1200px; margin: 0 auto; }
  #cn-pair-{{ section.id }} .cn-pair__head { text-align: center; margin-bottom: 28px; }
  #cn-pair-{{ section.id }} h2 { font-size: clamp(24px, 2.8vw, 34px); margin: 0 0 8px; color: inherit; }
  #cn-pair-{{ section.id }} .cn-pair__sub { margin: 0 auto; max-width: 620px; font-size: 15.5px; line-height: 1.55; opacity: .88; }
  #cn-pair-{{ section.id }} .cn-ship {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 14px;
    padding: 8px 14px; border-radius: 999px; font-size: 14px; font-weight: 600;
    background: {{ section.settings.pill_bg }}; color: {{ section.settings.pill_text }};
  }
  #cn-pair-{{ section.id }} .cn-ship svg { width: 18px; height: 18px; }
  #cn-pair-{{ section.id }} .cn-pair__grid {
    display: grid; gap: 16px;
    grid-template-columns: repeat({{ section.settings.limit | at_most: 4 }}, minmax(0, 1fr));
  }
  #cn-pair-{{ section.id }} .cn-pair__grid { position: relative; }
  /* position:relative keeps the absolutely-positioned (visually-hidden) labels
     inside each card; without it they escape the scrolling row on mobile and
     widen the whole page (horizontal scroll). */
  #cn-pair-{{ section.id }} .cn-card {
    position: relative;
    background: {{ section.settings.card_bg }}; border-radius: 14px; overflow: hidden;
    display: flex; flex-direction: column;
  }
  #cn-pair-{{ section.id }} .cn-card__img { display: block; aspect-ratio: 1 / 1; background: #DFF5E6; }
  #cn-pair-{{ section.id }} .cn-card__img img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #cn-pair-{{ section.id }} .cn-card__body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  #cn-pair-{{ section.id }} .cn-card__title { font-size: 15.5px; font-weight: 600; color: inherit; text-decoration: none; }
  #cn-pair-{{ section.id }} .cn-card__price { font-size: 14.5px; }
  #cn-pair-{{ section.id }} select {
    width: 100%; padding: 9px 10px; border-radius: 8px; border: 1px solid #D9CFBA;
    background: #fff; font: inherit; font-size: 14px; color: inherit;
  }
  #cn-pair-{{ section.id }} .cn-card form { margin-top: auto; display: grid; gap: 8px; }
  #cn-pair-{{ section.id }} .cn-btn {
    width: 100%; padding: 11px 12px; border: 0; border-radius: 999px; cursor: pointer;
    background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};
    font: inherit; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
  }
  #cn-pair-{{ section.id }} .cn-btn[disabled] { opacity: .5; cursor: not-allowed; }
  @media (max-width: 989px) {
    #cn-pair-{{ section.id }} .cn-pair__grid {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 62%;
      overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px;
    }
    #cn-pair-{{ section.id }} .cn-card { scroll-snap-align: start; }
  }
{%- endstyle -%}

{%- assign coll = section.settings.collection -%}
{%- if coll != blank and coll.products_count > 0 -%}
<section id="cn-pair-{{ section.id }}" class="cn-pair">
  <div class="cn-wrap">
    <div class="cn-pair__head">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="cn-pair__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.settings.show_ship and remaining > 0 -%}
        <span class="cn-ship">
          {%- render 'canister-icon', name: 'truck' -%}
          Add {{ remaining | money }} more and shipping is free
        </span>
      {%- endif -%}
    </div>

    <div class="cn-pair__grid">
      {%- assign shown = 0 -%}
      {%- for p in coll.products -%}
        {%- if p.id == product.id or p.available == false -%}{%- continue -%}{%- endif -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        <div class="cn-card">
          <a class="cn-card__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
            {%- if p.featured_image != blank -%}
              {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 62vw', alt: p.featured_image.alt | default: p.title }}
            {%- endif -%}
          </a>
          <div class="cn-card__body">
            <a class="cn-card__title" href="{{ p.url }}">{{ p.title }}</a>
            <span class="cn-card__price">{{ v.price | money }}</span>
            <form method="post" action="{{ routes.cart_add_url }}" class="cn-pair-form" data-cn-pair-form>
              {%- if p.has_only_default_variant -%}
                <input type="hidden" name="id" value="{{ v.id }}">
              {%- else -%}
                <label class="visually-hidden" for="cn-v-{{ section.id }}-{{ p.id }}">Options for {{ p.title }}</label>
                <select id="cn-v-{{ section.id }}-{{ p.id }}" name="id">
                  {%- for variant in p.variants -%}
                    <option value="{{ variant.id }}"{% if variant.id == v.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                      {{ variant.title }}{% unless variant.available %} (sold out){% endunless %}
                    </option>
                  {%- endfor -%}
                </select>
              {%- endif -%}
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="cn-btn">Add to cart</button>
            </form>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  /* AJAX add so shoppers stay on the canister page.
     Falls back to a normal form post (redirect to /cart) if JS fails. */
  (function () {
    var root = document.getElementById('cn-pair-{{ section.id }}');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    root.addEventListener('submit', function (e) {
      var form = e.target.closest('[data-cn-pair-form]');
      if (!form) return;
      e.preventDefault();
      var btn = form.querySelector('button');
      var label = btn.textContent;
      btn.disabled = true; btn.textContent = 'Adding…';
      fetch(window.Shopify && Shopify.routes ? Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(form.elements.id.value), quantity: 1 }] })
      })
        .then(function (r) { if (!r.ok) throw r; return r.json(); })
        .then(function () {
          btn.textContent = 'Added ✓';
          /* Tell the theme the cart changed (most OS 2.0 themes listen for one of these). */
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
            document.querySelectorAll('.cart-count-bubble span[aria-hidden], [data-cart-count]').forEach(function (el) {
              el.textContent = cart.item_count;
            });
          });
          setTimeout(function () { btn.disabled = false; btn.textContent = label; }, 1800);
        })
        .catch(function () { form.submit(); });
    });
  })();
</script>
{%- elsif request.design_mode -%}
  <div style="padding:40px;text-align:center;background:#F3E7CF">Canister pair-beans: pick a coffee collection in the section settings.</div>
{%- endif -%}

{% schema %}
{
  "name": "Canister pair with beans",
  "tag": "div",
  "class": "section-canister-pair",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Coffee collection to show" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fill it with fresh-roasted Latitude" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A canister is only as good as what's inside. Pick a bag roasted in Sarasota and start it fresh." },
    { "type": "checkbox", "id": "show_ship", "label": "Show free-shipping nudge", "default": true },
    { "type": "number", "id": "free_ship_threshold", "label": "Free-shipping threshold ($)", "default": 35, "info": "Match the announcement bar. The nudge hides if the canister alone already qualifies." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F8F5EC" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#F3E7CF" },
    { "type": "color", "id": "text", "label": "Text", "default": "#2B1208" },
    { "type": "color", "id": "pill_bg", "label": "Shipping pill background", "default": "#2F5D3A" },
    { "type": "color", "id": "pill_text", "label": "Shipping pill text", "default": "#FFFFFF" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#3A1A0E" },
    { "type": "color", "id": "btn_text", "label": "Button text", "default": "#FFFFFF" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Canister pair with beans" }]
}
{% endschema %}
