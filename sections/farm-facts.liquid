{%- comment -%} Farm Direct — fact cards (altitude, region, varietals…). Empty values are hidden on the live site. {%- endcomment -%}
{%- liquid
  assign filled = 0
  for block in section.blocks
    if block.settings.value != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
{%- style -%}
  #ff-{{ section.id }} { background: {{ section.settings.bg }}; color: {{ section.settings.text }}; padding: {{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px; }
  #ff-{{ section.id }} .ff__wrap { max-width: 1200px; margin: 0 auto; }
  #ff-{{ section.id }} h2 { font-size: clamp(22px, 2.4vw, 30px); margin: 0 0 26px; text-align: center; color: inherit; }
  #ff-{{ section.id }} ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
  #ff-{{ section.id }} li { background: {{ section.settings.card_bg }}; border-radius: 14px; padding: 20px 16px; text-align: center; }
  #ff-{{ section.id }} .ff__ic { width: 36px; height: 36px; margin: 0 auto 10px; color: {{ section.settings.accent }}; }
  #ff-{{ section.id }} .ff__ic svg { width: 100%; height: 100%; }
  #ff-{{ section.id }} .ff__label { display: block; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; opacity: .7; margin-bottom: 4px; }
  #ff-{{ section.id }} .ff__value { display: block; font-size: 17px; font-weight: 700; line-height: 1.3; }
  @media (max-width: 749px) { #ff-{{ section.id }} ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } }
{%- endstyle -%}

{%- if filled > 0 or request.design_mode -%}
<section id="ff-{{ section.id }}" class="farm-facts">
  <div class="ff__wrap">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <ul>
      {%- for block in section.blocks -%}
        {%- if block.settings.value != blank or request.design_mode -%}
          <li {{ block.shopify_attributes }}{% if block.settings.value == blank %} style="opacity:.4"{% endif %}>
            <div class="ff__ic" aria-hidden="true">{%- render 'farm-icon', name: block.settings.icon -%}</div>
            <span class="ff__label">{{ block.settings.label }}</span>
            <span class="ff__value">{{ block.settings.value | default: 'Empty, hidden on live site' }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Farm facts",
  "tag": "div",
  "class": "section-farm-facts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "At a glance" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F8F5EC" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#F3E7CF" },
    { "type": "color", "id": "text", "label": "Text", "default": "#2B1208" },
    { "type": "color", "id": "accent", "label": "Icon color", "default": "#2F5D3A" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "limit": 10,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "pin",
          "options": [
            { "value": "pin", "label": "Location pin" }, { "value": "mountain", "label": "Altitude" },
            { "value": "leaf", "label": "Leaf / varietal" }, { "value": "cherry", "label": "Coffee cherry" },
            { "value": "drop", "label": "Process" }, { "value": "sun", "label": "Climate / drying" },
            { "value": "calendar", "label": "Harvest" }, { "value": "person", "label": "Producer" },
            { "value": "cup", "label": "Tasting notes" }, { "value": "globe", "label": "Globe" }
          ] },
        { "type": "text", "id": "label", "label": "Label", "default": "Region" },
        { "type": "text", "id": "value", "label": "Value (empty = hidden)" }
      ] }
  ],
  "presets": [ { "name": "Farm facts", "blocks": [
    { "type": "fact", "settings": { "icon": "pin", "label": "Region" } },
    { "type": "fact", "settings": { "icon": "mountain", "label": "Altitude" } },
    { "type": "fact", "settings": { "icon": "leaf", "label": "Varietals" } },
    { "type": "fact", "settings": { "icon": "drop", "label": "Process" } },
    { "type": "fact", "settings": { "icon": "calendar", "label": "Harvest" } },
    { "type": "fact", "settings": { "icon": "person", "label": "Producer" } }
  ] } ]
}
{% endschema %}
