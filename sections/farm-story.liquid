{%- comment -%} Farm Direct — story block (image + text). Add it several times, alternating image side. {%- endcomment -%}
{%- assign has_content = false -%}
{%- if section.settings.heading != blank or section.settings.text != blank -%}{%- assign has_content = true -%}{%- endif -%}
{%- style -%}
  #fs-{{ section.id }} { background: {{ section.settings.bg }}; color: {{ section.settings.text_color }}; padding: {{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px; }
  #fs-{{ section.id }} .fs__wrap {
    max-width: 1200px; margin: 0 auto; display: grid; gap: 56px; align-items: center;
    grid-template-columns: {% if section.settings.image != blank %}1fr 1fr{% else %}1fr{% endif %};
  }
  {%- if section.settings.image_side == 'right' -%}#fs-{{ section.id }} .fs__media { order: 2; }{%- endif -%}
  #fs-{{ section.id }} .fs__media img { width: 100%; height: auto; display: block; border-radius: 18px; aspect-ratio: {{ section.settings.ratio }}; object-fit: cover; }
  #fs-{{ section.id }} .fs__cap { font-size: 13px; opacity: .7; margin: 8px 2px 0; }
  #fs-{{ section.id }} .fs__copy { {% if section.settings.image == blank %}max-width: 760px; margin: 0 auto;{% endif %} }
  #fs-{{ section.id }} .fs__eyebrow { font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: {{ section.settings.accent }}; font-weight: 700; margin: 0 0 8px; }
  #fs-{{ section.id }} h2 { font-size: clamp(26px, 3vw, 38px); line-height: 1.15; margin: 0 0 18px; color: inherit; }
  #fs-{{ section.id }} .fs__text { font-size: 16.5px; line-height: 1.7; }
  #fs-{{ section.id }} .fs__text p { margin: 0 0 14px; }
  #fs-{{ section.id }} .fs__btn { display: inline-block; margin-top: 8px; padding: 12px 24px; border-radius: 999px; background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }}; text-decoration: none; font-weight: 700; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }
  @media (max-width: 749px) {
    #fs-{{ section.id }} .fs__wrap { grid-template-columns: 1fr; gap: 26px; }
    #fs-{{ section.id }} .fs__media { order: 0; }
  }
{%- endstyle -%}

{%- if has_content or request.design_mode -%}
<section id="fs-{{ section.id }}" class="farm-story">
  <div class="fs__wrap">
    {%- if section.settings.image != blank -%}
      <figure class="fs__media" style="margin:0">
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '450, 750, 1000, 1400', alt: section.settings.image.alt | default: section.settings.heading }}
        {%- if section.settings.caption != blank -%}<figcaption class="fs__cap">{{ section.settings.caption }}</figcaption>{%- endif -%}
      </figure>
    {%- endif -%}
    <div class="fs__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="fs__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="fs__text">{{ section.settings.text }}</div>
      {%- elsif request.design_mode -%}<p style="opacity:.5"><em>Add story text, this section is hidden on the live site until it has a heading or text.</em></p>{%- endif -%}
      {%- if section.settings.btn_label != blank and section.settings.btn_link != blank -%}<a class="fs__btn" href="{{ section.settings.btn_link }}">{{ section.settings.btn_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Farm story",
  "tag": "div",
  "class": "section-farm-story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "caption", "label": "Image caption" },
    { "type": "select", "id": "image_side", "label": "Image side (desktop)", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "select", "id": "ratio", "label": "Image shape", "default": "4 / 5", "options": [ { "value": "4 / 5", "label": "Portrait" }, { "value": "1 / 1", "label": "Square" }, { "value": "4 / 3", "label": "Landscape" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The farm" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn_label", "label": "Button label" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2B1208" },
    { "type": "color", "id": "accent", "label": "Eyebrow", "default": "#2F5D3A" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#3A1A0E" },
    { "type": "color", "id": "btn_text", "label": "Button text", "default": "#FFFFFF" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [ { "name": "Farm story" } ]
}
{% endschema %}
