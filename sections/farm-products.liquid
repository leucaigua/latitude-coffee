{%- comment -%}
  Farm Direct — "From this farm" products.
  Pick products by hand (product list) or fall back to a collection.
  Cards add to cart via AJAX so shoppers stay on the story page.
{%- endcomment -%}
{%- liquid
  if section.settings.products != blank and section.settings.products.size > 0
    assign items = section.settings.products
  elsif section.settings.collection != blank
    assign items = section.settings.collection.products
  else
    assign items = nil
  endif
  assign cols = section.settings.columns
-%}
{%- style -%}
  #fp-{{ section.id }} { background: {{ section.settings.bg }}; color: {{ section.settings.text }}; padding: {{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px; scroll-margin-top: 90px; }
  #fp-{{ section.id }} .fp__wrap { max-width: 1200px; margin: 0 auto; }
  #fp-{{ section.id }} .fp__head { text-align: center; margin-bottom: 30px; }
  #fp-{{ section.id }} .fp__eyebrow { font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: {{ section.settings.accent }}; font-weight: 700; margin: 0 0 8px; }
  #fp-{{ section.id }} h2 { font-size: clamp(26px, 3vw, 38px); margin: 0 0 10px; color: inherit; }
  #fp-{{ section.id }} .fp__sub { max-width: 640px; margin: 0 auto; font-size: 15.5px; line-height: 1.55; opacity: .88; }
  #fp-{{ section.id }} .fp__grid { position: relative; display: grid; gap: 18px; grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); }
  #fp-{{ section.id }} .fp__card { position: relative; background: {{ section.settings.card_bg }}; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; }
  #fp-{{ section.id }} .fp__img { display: block; aspect-ratio: 1 / 1; background: {{ section.settings.img_bg }}; }
  #fp-{{ section.id }} .fp__img img { width: 100%; height: 100%; object-fit: contain; display: block; }
  #fp-{{ section.id }} .fp__body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  #fp-{{ section.id }} .fp__title { font-size: 17px; font-weight: 700; color: inherit; text-decoration: none; }
  #fp-{{ section.id }} .fp__notes { font-size: 14px; line-height: 1.45; opacity: .85; margin: 0; }
  #fp-{{ section.id }} .fp__price { font-size: 15px; }
  #fp-{{ section.id }} select { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #D9CFBA; background: #fff; font: inherit; font-size: 14px; color: inherit; }
  #fp-{{ section.id }} .fp__card form { margin-top: auto; display: grid; gap: 8px; }
  #fp-{{ section.id }} .fp__btn { width: 100%; padding: 12px; border: 0; border-radius: 999px; cursor: pointer; background: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }}; font: inherit; font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  #fp-{{ section.id }} .fp__btn[disabled] { opacity: .55; cursor: not-allowed; }
  #fp-{{ section.id }} .fp__all { text-align: center; margin-top: 26px; }
  #fp-{{ section.id }} .fp__all a { color: inherit; font-weight: 700; text-underline-offset: 4px; }
  @media (max-width: 989px) {
    #fp-{{ section.id }} .fp__grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 66%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; }
    #fp-{{ section.id }} .fp__card { scroll-snap-align: start; }
  }
{%- endstyle -%}

{%- if items != nil -%}
<section id="fp-{{ section.id }}" class="farm-products">
  <span id="farm-products" style="position:relative;top:-90px"></span>
  <div class="fp__wrap">
    <div class="fp__head">
      {%- if section.settings.eyebrow != blank -%}<p class="fp__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="fp__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="fp__grid">
      {%- assign shown = 0 -%}
      {%- for p in items -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        <div class="fp__card">
          <a class="fp__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
            {%- if p.featured_image != blank -%}
              {{ p.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 33vw, 66vw', alt: p.featured_image.alt }}
            {%- endif -%}
          </a>
          <div class="fp__body">
            <a class="fp__title" href="{{ p.url }}">{{ p.title }}</a>
            {%- if section.settings.show_notes -%}
              {%- assign notes = p.metafields.custom.tasting_notes.value | default: p.metafields.custom.flavor.value -%}
              {%- if notes != blank -%}<p class="fp__notes">{{ notes | strip_html | truncate: 110 }}</p>{%- endif -%}
            {%- endif -%}
            <span class="fp__price">{{ v.price | money }}</span>
            {%- if p.available -%}
              <product-form-component id="farm-form-{{ section.id }}-{{ p.id }}" data-section-id="{{ section.id }}" data-product-id="{{ p.id }}" on:submit="/handleSubmit">
                <div class="visually-hidden" ref="liveRegion" role="status" aria-live="polite"></div>
                <form method="post" action="{{ routes.cart_add_url }}" data-type="add-to-cart-form">
                {%- if p.has_only_default_variant -%}
                  <input type="hidden" name="id" ref="variantId" value="{{ v.id }}">
                {%- else -%}
                  <label class="visually-hidden" for="fp-v-{{ section.id }}-{{ p.id }}">Options for {{ p.title }}</label>
                  <select id="fp-v-{{ section.id }}-{{ p.id }}" name="id" ref="variantId">
                    {%- for variant in p.variants -%}
                      <option value="{{ variant.id }}"{% if variant.id == v.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} (sold out){% endunless %}</option>
                    {%- endfor -%}
                  </select>
                {%- endif -%}
                <input type="hidden" name="quantity" value="1">
                {% assign add_label = 'actions.add_to_cart' | t %}
                {% render 'add-to-cart-button', add_to_cart_text: add_label, product: p, can_add_to_cart: true, class: 'fp__btn', show_icon: false %}
                <span class="fp__error hidden" ref="addToCartTextError" role="alert"></span>
              </form>
              </product-form-component>
            {%- else -%}
              <a class="fp__btn" href="{{ p.url }}" style="text-align:center;text-decoration:none">Sold out · View</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.all_label != blank and section.settings.all_link != blank -%}
      <p class="fp__all"><a href="{{ section.settings.all_link }}">{{ section.settings.all_label }}</a></p>
    {%- endif -%}
  </div>
</section>


{%- elsif request.design_mode -%}
  <div style="padding:48px 20px;text-align:center;background:#F3E7CF">From this farm: pick products (or a collection) in the section settings.</div>
{%- endif -%}

{% schema %}
{
  "name": "Farm products",
  "tag": "div",
  "class": "section-farm-products",
  "settings": [
    { "type": "product_list", "id": "products", "label": "Products from this farm", "limit": 8 },
    { "type": "collection", "id": "collection", "label": "Or use a collection", "info": "Used only if no products are picked above." },
    { "type": "range", "id": "limit", "label": "Max products", "min": 1, "max": 8, "step": 1, "default": 6 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_notes", "label": "Show tasting notes", "default": true, "info": "Reads the product metafield custom.tasting_notes (or custom.flavor). Hidden when empty." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From this farm" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Taste the farm" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "all_label", "label": "'Shop all' link label", "default": "Shop all farm-direct coffee" },
    { "type": "url", "id": "all_link", "label": "'Shop all' link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#F3E7CF" },
    { "type": "color", "id": "img_bg", "label": "Image background", "default": "#DFF5E6" },
    { "type": "color", "id": "text", "label": "Text", "default": "#2B1208" },
    { "type": "color", "id": "accent", "label": "Eyebrow", "default": "#2F5D3A" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#3A1A0E" },
    { "type": "color", "id": "btn_text", "label": "Button text", "default": "#FFFFFF" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [ { "name": "Farm products" } ]
}
{% endschema %}
