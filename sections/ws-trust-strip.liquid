{%- comment -%} Wholesale trust strip: statement + icon proof points. {%- endcomment -%}
{%- style -%}
  #wst-{{ section.id }} { background: {{ section.settings.bg }}; color: {{ section.settings.text }}; padding: 44px 20px; }
  #wst-{{ section.id }} .wst__in { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1.2fr repeat({{ section.blocks.size | at_least: 1 }}, 1fr); gap: 28px; align-items: center; }
  #wst-{{ section.id }} h2 { font-size: 22px; line-height: 1.3; margin: 0; color: inherit; }
  #wst-{{ section.id }} .wst__item { display: flex; gap: 12px; align-items: center; font-size: 14.5px; line-height: 1.35; }
  #wst-{{ section.id }} .wst__ic { flex: 0 0 42px; width: 42px; height: 42px; color: inherit; }
  #wst-{{ section.id }} .wst__ic svg { width: 100%; height: 100%; }
  @media (max-width: 749px) {
    #wst-{{ section.id }} .wst__in { grid-template-columns: 1fr; gap: 18px; }
    #wst-{{ section.id }} h2 { text-align: center; }
    #wst-{{ section.id }} .wst__item { justify-content: flex-start; max-width: 280px; margin: 0 auto; width: 100%; }
  }
{%- endstyle -%}
<section id="wst-{{ section.id }}" class="ws-trust">
  <div class="wst__in">
    <h2>{{ section.settings.heading | newline_to_br }}</h2>
    {%- for block in section.blocks -%}
      <div class="wst__item" {{ block.shopify_attributes }}>
        <span class="wst__ic" aria-hidden="true">{%- render 'ws-icon', name: block.settings.icon -%}</span>
        <span>{{ block.settings.text | newline_to_br }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Wholesale trust strip",
  "tag": "div",
  "class": "section-ws-trust",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Statement", "default": "More Than Roasters,\nWe Are Your Partners." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F3E7CF" },
    { "type": "color", "id": "text", "label": "Text", "default": "#2B1208" }
  ],
  "blocks": [
    { "type": "item", "name": "Proof point", "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "handshake",
          "options": [
            { "value": "handshake", "label": "Handshake" }, { "value": "bean", "label": "Coffee bean" }, { "value": "box", "label": "Box" },
            { "value": "truck", "label": "Truck" }, { "value": "award", "label": "Award" }, { "value": "flame", "label": "Roasting" }, { "value": "check", "label": "Check" }
          ] },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Proof point" }
      ] }
  ],
  "presets": [ { "name": "Wholesale trust strip" } ]
}
{% endschema %}
