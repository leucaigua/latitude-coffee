{%- comment -%} Farm Direct — "From farm to cup" journey timeline. {%- endcomment -%}
{%- style -%}
  #fj-{{ section.id }} { background: {{ section.settings.bg }}; color: {{ section.settings.text }}; padding: {{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px; }
  #fj-{{ section.id }} .fj__wrap { max-width: 1200px; margin: 0 auto; }
  #fj-{{ section.id }} h2 { font-size: clamp(24px, 2.8vw, 34px); margin: 0 0 8px; text-align: center; color: inherit; }
  #fj-{{ section.id }} .fj__sub { text-align: center; max-width: 640px; margin: 0 auto 36px; font-size: 15.5px; line-height: 1.55; opacity: .85; }
  #fj-{{ section.id }} ol { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 18px; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 5 }}, minmax(0, 1fr)); }
  #fj-{{ section.id }} ol::before { content: ''; position: absolute; top: 26px; left: 10%; right: 10%; height: 2px; background: {{ section.settings.line }}; }
  #fj-{{ section.id }} li { position: relative; text-align: center; padding: 0 6px; }
  #fj-{{ section.id }} .fj__ic { position: relative; width: 54px; height: 54px; margin: 0 auto 14px; border-radius: 50%; background: {{ section.settings.accent }}; color: #fff; display: grid; place-items: center; }
  #fj-{{ section.id }} .fj__ic svg { width: 28px; height: 28px; }
  #fj-{{ section.id }} h3 { font-size: 16.5px; margin: 0 0 6px; color: inherit; }
  #fj-{{ section.id }} li p { margin: 0; font-size: 14.5px; line-height: 1.5; opacity: .85; }
  @media (max-width: 749px) {
    #fj-{{ section.id }} ol { grid-template-columns: 1fr; gap: 22px; }
    #fj-{{ section.id }} ol::before { top: 0; bottom: 0; left: 26px; right: auto; width: 2px; height: auto; }
    #fj-{{ section.id }} li { display: grid; grid-template-columns: 54px 1fr; gap: 14px; text-align: left; padding: 0; }
    #fj-{{ section.id }} .fj__ic { margin: 0; }
  }
{%- endstyle -%}

<section id="fj-{{ section.id }}" class="farm-journey">
  <div class="fj__wrap">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="fj__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    <ol>
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <div class="fj__ic" aria-hidden="true">{%- render 'farm-icon', name: block.settings.icon -%}</div>
          <div>
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Farm journey",
  "tag": "div",
  "class": "section-farm-journey",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the farm to your cup" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F8F5EC" },
    { "type": "color", "id": "text", "label": "Text", "default": "#2B1208" },
    { "type": "color", "id": "accent", "label": "Icon circle", "default": "#2F5D3A" },
    { "type": "color", "id": "line", "label": "Connector line", "default": "#E0A43B" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "limit": 5,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "cherry",
          "options": [
            { "value": "cherry", "label": "Coffee cherry" }, { "value": "sun", "label": "Drying" },
            { "value": "drop", "label": "Washing" }, { "value": "ship", "label": "Shipping" },
            { "value": "flame", "label": "Roasting" }, { "value": "cup", "label": "Cup" },
            { "value": "person", "label": "People" }, { "value": "globe", "label": "Globe" }
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ] }
  ],
  "presets": [ { "name": "Farm journey", "blocks": [
    { "type": "step", "settings": { "icon": "cherry", "title": "Grown & picked" } },
    { "type": "step", "settings": { "icon": "sun", "title": "Processed & dried" } },
    { "type": "step", "settings": { "icon": "ship", "title": "Shipped to Sarasota" } },
    { "type": "step", "settings": { "icon": "flame", "title": "Roasted in Sarasota, FL" } }
  ] } ]
}
{% endschema %}
