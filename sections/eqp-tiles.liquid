{%- comment -%}
  Machine PDP tile row. Two sources:
  - "blocks": What's included (optional first tile = this product's image + title) + tiles you add.
  - "requirements": reads product metafield custom.install_requirements (multi-line text, one per line,
    e.g. "120V outlet"), icon picked by keyword (outlet/volt → plug, water/filter → filter, pressure → gauge…).
  Hidden when there is nothing to show.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign req_lines = product.metafields.custom.install_requirements.value | newline_to_br | split: '<br />'
  assign has_items = false
  if s.source == 'requirements'
    for l in req_lines
      assign t = l | strip
      if t != blank
        assign has_items = true
        break
      endif
    endfor
  elsif section.blocks.size > 0 or s.show_product
    assign has_items = true
  endif
-%}
{%- style -%}
  #eqt-{{ section.id }} { background: {{ s.bg }}; color: {{ s.text }}; padding: {{ s.pad_top }}px 20px {{ s.pad_bottom }}px; text-align: center; }
  #eqt-{{ section.id }} .eqt__in { max-width: 1040px; margin: 0 auto; }
  #eqt-{{ section.id }} h2 { font-size: clamp(22px, 2.4vw, 28px); text-transform: uppercase; letter-spacing: .02em; margin: 0 0 6px; color: inherit; }
  #eqt-{{ section.id }} .eqt__sub { font-size: 14.5px; margin: 0 0 18px; opacity: .8; }
  #eqt-{{ section.id }} .eqt__row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 14px; }
  #eqt-{{ section.id }} .eqt__tile { display: flex; gap: 12px; align-items: center; text-align: left; min-width: 220px; flex: 0 1 240px; padding: 10px 14px; border: 1px solid {{ s.line }}; border-radius: 10px; background: {{ s.tile_bg }}; font-size: 14px; line-height: 1.3; }
  #eqt-{{ section.id }} .eqt__ic { flex: 0 0 48px; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: {{ s.icon_bg }}; color: {{ s.icon }}; overflow: hidden; }
  #eqt-{{ section.id }} .eqt__ic svg { width: 26px; height: 26px; }
  #eqt-{{ section.id }} .eqt__ic img { width: 100%; height: 100%; object-fit: contain; }
  #eqt-{{ section.id }} .eqt__ic--img { border-radius: 8px; background: #fff; }
  #eqt-{{ section.id }} .eqt__tile a { display: block; font-size: 12.5px; text-decoration: underline; color: inherit; opacity: .8; margin-top: 2px; }
  #eqt-{{ section.id }} .eqt__foot { font-size: 13.5px; margin: 16px 0 0; opacity: .85; }
  #eqt-{{ section.id }} .eqt__foot a { color: inherit; text-decoration: underline; }
  @media (max-width: 749px) { #eqt-{{ section.id }} .eqt__tile { flex: 1 1 100%; } }
{%- endstyle -%}
{%- if has_items or request.design_mode -%}
<section id="eqt-{{ section.id }}" class="eqp-tiles">
  <div class="eqt__in">
    {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
    {%- if s.subheading != blank -%}<p class="eqt__sub">{{ s.subheading }}</p>{%- endif -%}
    <div class="eqt__row">
      {%- if s.source == 'requirements' -%}
        {%- for l in req_lines -%}
          {%- assign t = l | strip -%}
          {%- if t == blank -%}{%- continue -%}{%- endif -%}
          <div class="eqt__tile"><span class="eqt__ic">{%- render 'eqp-icon', name: 'auto', label: t -%}</span><span>{{ t }}</span></div>
        {%- endfor -%}
        {%- if has_items == false and request.design_mode -%}<p style="opacity:.6">Fill the product metafield custom.install_requirements (one requirement per line) to show tiles here.</p>{%- endif -%}
      {%- else -%}
        {%- if s.show_product -%}
          <div class="eqt__tile">
            <span class="eqt__ic eqt__ic--img">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
            <span>{{ product.title }}</span>
          </div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          <div class="eqt__tile" {{ block.shopify_attributes }}>
            <span class="eqt__ic{% if block.settings.image != blank %} eqt__ic--img{% endif %}">
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{%- render 'eqp-icon', name: block.settings.icon -%}{%- endif -%}
            </span>
            <span>{{ block.settings.text }}{%- if block.settings.link_label != blank and block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>{%- endif -%}</span>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if s.footnote != blank -%}<div class="eqt__foot">{{ s.footnote }}</div>{%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Machine: tile row",
  "tag": "div",
  "class": "section-eqp-tiles",
  "settings": [
    { "type": "select", "id": "source", "label": "Content", "default": "blocks", "options": [ { "value": "blocks", "label": "Tiles (What's included)" }, { "value": "requirements", "label": "Product metafield: install requirements" } ] },
    { "type": "checkbox", "id": "show_product", "label": "First tile = this product (Tiles mode)", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's included?" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "richtext", "id": "footnote", "label": "Footnote" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "tile_bg", "label": "Tile background", "default": "#FFFFFF" },
    { "type": "color", "id": "icon_bg", "label": "Icon circle", "default": "#F3E7CF" },
    { "type": "color", "id": "icon", "label": "Icon", "default": "#3A1A0E" },
    { "type": "color", "id": "text", "label": "Text", "default": "#2B1208" },
    { "type": "color", "id": "line", "label": "Tile border", "default": "#E6DCC6" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 12 }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "limit": 8,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "headset",
          "options": [ { "value": "headset", "label": "Support" }, { "value": "truck", "label": "Shipping" }, { "value": "shield", "label": "Warranty" }, { "value": "bean", "label": "Coffee" }, { "value": "box", "label": "Box" }, { "value": "doc", "label": "Document" }, { "value": "medal", "label": "Medal" } ] },
        { "type": "image_picker", "id": "image", "label": "Image (overrides icon)" },
        { "type": "text", "id": "text", "label": "Text", "default": "Included item" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ] }
  ],
  "presets": [ { "name": "Machine: tile row" } ]
}
{% endschema %}
