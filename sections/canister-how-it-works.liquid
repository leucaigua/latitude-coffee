{%- comment -%}
  Canister — How it works (image + numbered steps + freshness tip)
{%- endcomment -%}
{%- style -%}
  #cn-how-{{ section.id }} {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text }};
    padding: {{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px;
  }
  #cn-how-{{ section.id }} .cn-wrap {
    max-width: 1200px; margin: 0 auto;
    display: grid; gap: 48px; align-items: center;
    grid-template-columns: {% if section.settings.image != blank %}1fr 1fr{% else %}1fr{% endif %};
  }
  #cn-how-{{ section.id }} .cn-how__media img { width: 100%; height: auto; border-radius: 18px; display: block; }
  #cn-how-{{ section.id }} .cn-eyebrow { font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: {{ section.settings.accent }}; font-weight: 600; margin: 0 0 8px; }
  #cn-how-{{ section.id }} h2 { font-size: clamp(24px, 2.8vw, 34px); margin: 0 0 28px; color: inherit; }
  #cn-how-{{ section.id }} ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  #cn-how-{{ section.id }} li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; }
  #cn-how-{{ section.id }} .cn-num {
    width: 40px; height: 40px; border-radius: 50%;
    background: {{ section.settings.accent }}; color: #fff;
    display: grid; place-items: center; font-weight: 700;
  }
  #cn-how-{{ section.id }} h3 { font-size: 17px; margin: 6px 0 4px; color: inherit; }
  #cn-how-{{ section.id }} li p { margin: 0; font-size: 15px; line-height: 1.55; opacity: .88; }
  #cn-how-{{ section.id }} .cn-tip {
    margin-top: 28px; padding: 18px 20px; border-radius: 12px;
    background: {{ section.settings.tip_bg }}; border-left: 4px solid {{ section.settings.tip_border }};
    font-size: 14.5px; line-height: 1.55;
  }
  #cn-how-{{ section.id }} .cn-tip strong { display: block; margin-bottom: 4px; }
  #cn-how-{{ section.id }} .cn-tip p { margin: 0; }
  @media (max-width: 749px) {
    #cn-how-{{ section.id }} .cn-wrap { grid-template-columns: 1fr; gap: 28px; }
    {% if section.settings.image_first_mobile == false %}#cn-how-{{ section.id }} .cn-how__media { order: 2; }{% endif %}
  }
{%- endstyle -%}

<section id="cn-how-{{ section.id }}" class="cn-how">
  <div class="cn-wrap">
    {%- if section.settings.image != blank -%}
      <div class="cn-how__media">
        {{ section.settings.image | image_url: width: 1200 | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 750px) 50vw, 100vw',
          widths: '400, 600, 800, 1000, 1200',
          alt: section.settings.image.alt | default: section.settings.heading }}
      </div>
    {%- endif -%}
    <div class="cn-how__content">
      {%- if section.settings.eyebrow != blank -%}<p class="cn-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- assign step_n = 0 -%}
      <ol>
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_n = step_n | plus: 1 -%}
            <li {{ block.shopify_attributes }}>
              <span class="cn-num" aria-hidden="true">{{ step_n }}</span>
              <div>
                <h3>{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
      {%- for block in section.blocks -%}
        {%- if block.type == 'tip' -%}
          <div class="cn-tip" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.title }}</strong>
            {{ block.settings.text }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Canister how it works",
  "tag": "div",
  "class": "section-canister-how",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (lifestyle or lid close-up)" },
    { "type": "checkbox", "id": "image_first_mobile", "label": "Show image first on mobile", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seal it in three seconds" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text", "label": "Text", "default": "#2B1208" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#2F5D3A" },
    { "type": "color", "id": "tip_bg", "label": "Tip background", "default": "#F3E7CF" },
    { "type": "color", "id": "tip_border", "label": "Tip border", "default": "#E0A43B" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "step", "name": "Step", "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Fill" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "tip", "name": "Freshness tip", "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Using fresh-roasted beans?" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Freshly roasted coffee keeps releasing CO₂ for a few days. Let new beans rest 2–3 days before vacuum sealing, or press the lid again after the first day.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Canister how it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Fill", "text": "Pour in your whole beans, grounds or loose-leaf tea." } },
        { "type": "step", "settings": { "title": "Press to seal", "text": "Close the lid and press the large button to push the air out." } },
        { "type": "step", "settings": { "title": "Tap to open", "text": "Press the small release button and the lid lifts right off." } },
        { "type": "tip" }
      ]
    }
  ]
}
{% endschema %}
