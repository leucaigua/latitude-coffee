{%- comment -%} Wholesale downloadable flyers. Thumbnail = picked image, or the file itself if it's an image URL. {%- endcomment -%}
{%- style -%}
  #wsd-{{ section.id }} { background: {{ section.settings.bg }}; color: {{ section.settings.text }}; padding: {{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px; }
  #wsd-{{ section.id }} .wsd__in { max-width: 1000px; margin: 0 auto; text-align: center; }
  #wsd-{{ section.id }} h2 { font-size: clamp(26px, 3vw, 36px); margin: 0 0 14px; color: inherit; }
  #wsd-{{ section.id }} .wsd__sub { max-width: 620px; margin: 0 auto 36px; font-size: 16px; line-height: 1.6; opacity: .8; }
  #wsd-{{ section.id }} .wsd__grid { display: grid; gap: 22px; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr)); }
  #wsd-{{ section.id }} .wsd__item { display: flex; flex-direction: column; align-items: center; gap: 14px; text-decoration: none; color: inherit; }
  #wsd-{{ section.id }} .wsd__thumb { width: 100%; max-width: 280px; aspect-ratio: 4 / 5; border-radius: 8px; overflow: hidden; background: #fff; box-shadow: 0 8px 22px rgba(43,18,8,.14); transition: transform .3s ease, box-shadow .3s ease; }
  #wsd-{{ section.id }} .wsd__item:hover .wsd__thumb { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(43,18,8,.2); }
  #wsd-{{ section.id }} .wsd__thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  #wsd-{{ section.id }} .wsd__label { font-weight: 700; font-size: 15px; line-height: 1.35; display: inline-flex; gap: 8px; align-items: center; }
  #wsd-{{ section.id }} .wsd__label svg { width: 16px; height: 16px; flex: 0 0 16px; }
  @media (max-width: 749px) {
    #wsd-{{ section.id }} .wsd__grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 72%; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 4px 16px; position: relative; }
    #wsd-{{ section.id }} .wsd__item { scroll-snap-align: center; }
  }
{%- endstyle -%}
<section id="wsd-{{ section.id }}" class="ws-downloads">
  <div class="wsd__in">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="wsd__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    <div class="wsd__grid">
      {%- for block in section.blocks -%}
        {%- assign href = block.settings.file_url -%}
        <a class="wsd__item" href="{{ href | default: '#' }}" target="_blank" rel="noopener" download {{ block.shopify_attributes }}>
          <span class="wsd__thumb">
            {%- if block.settings.thumb != blank -%}
              {{ block.settings.thumb | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 30vw, 72vw', alt: '' }}
            {%- elsif href contains '.png' or href contains '.jpg' or href contains '.jpeg' or href contains '.webp' -%}
              <img src="{{ href }}" alt="" loading="lazy" width="560" height="700">
            {%- endif -%}
          </span>
          <span class="wsd__label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 20h16"/></svg>
            {{ block.settings.label }}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Wholesale downloads",
  "tag": "div",
  "class": "section-ws-downloads",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to Elevate Your Coffee Standard?" },
    { "type": "textarea", "id": "subheading", "label": "Text", "default": "Contact us today and get expert advice from our team. Download our process guides below to learn more about how we work." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F3E7CF" },
    { "type": "color", "id": "text", "label": "Text", "default": "#2B1208" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "file", "name": "Download", "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Download" },
        { "type": "url", "id": "file_url", "label": "File URL (PDF or image)", "info": "Upload in Content → Files, then paste the link." },
        { "type": "image_picker", "id": "thumb", "label": "Thumbnail (optional if the file is an image)" }
      ] }
  ],
  "presets": [ { "name": "Wholesale downloads" } ]
}
{% endschema %}
