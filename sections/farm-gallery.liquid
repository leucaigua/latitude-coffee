{%- comment -%} Farm Direct — photo gallery (grid on desktop, swipe row on mobile). {%- endcomment -%}
{%- liquid
  assign imgs = 0
  for block in section.blocks
    if block.settings.image != blank
      assign imgs = imgs | plus: 1
    endif
  endfor
-%}
{%- style -%}
  #fg-{{ section.id }} { background: {{ section.settings.bg }}; color: {{ section.settings.text }}; padding: {{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px; }
  #fg-{{ section.id }} .fg__wrap { max-width: 1200px; margin: 0 auto; }
  #fg-{{ section.id }} h2 { font-size: clamp(22px, 2.4vw, 30px); margin: 0 0 24px; text-align: center; color: inherit; }
  #fg-{{ section.id }} .fg__grid { position: relative; display: grid; gap: 12px; grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr)); }
  #fg-{{ section.id }} figure { position: relative; margin: 0; border-radius: 14px; overflow: hidden; }
  #fg-{{ section.id }} figure.fg--wide { grid-column: span 2; }
  #fg-{{ section.id }} img { width: 100%; height: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block; }
  #fg-{{ section.id }} figure.fg--wide img { aspect-ratio: 2 / 1; }
  #fg-{{ section.id }} figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 22px 12px 10px; font-size: 13px; color: #fff; background: linear-gradient(to top, rgba(0,0,0,.6), rgba(0,0,0,0)); }
  @media (max-width: 749px) {
    #fg-{{ section.id }} .fg__grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 78%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; }
    #fg-{{ section.id }} figure, #fg-{{ section.id }} figure.fg--wide { grid-column: auto; scroll-snap-align: start; }
    #fg-{{ section.id }} figure.fg--wide img { aspect-ratio: 1 / 1; }
  }
{%- endstyle -%}

{%- if imgs > 0 or request.design_mode -%}
<section id="fg-{{ section.id }}" class="farm-gallery">
  <div class="fg__wrap">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="fg__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <figure class="{% if block.settings.wide %}fg--wide{% endif %}" {{ block.shopify_attributes }}>
            {% assign image_alt = block.settings.image.alt | default: block.settings.caption %}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 78vw', widths: '400, 600, 900, 1200', alt: image_alt }}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
          </figure>
        {%- elsif request.design_mode -%}
          <figure {{ block.shopify_attributes }} style="background:#eee;aspect-ratio:1/1;display:grid;place-items:center;font-size:13px;opacity:.6">Pick an image</figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Farm gallery",
  "tag": "div",
  "class": "section-farm-gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Life on the farm" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F8F5EC" },
    { "type": "color", "id": "text", "label": "Text", "default": "#2B1208" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "checkbox", "id": "wide", "label": "Wide (spans 2 columns)", "default": false }
      ] }
  ],
  "presets": [ { "name": "Farm gallery", "blocks": [ { "type": "photo" }, { "type": "photo" }, { "type": "photo" } ] } ]
}
{% endschema %}
