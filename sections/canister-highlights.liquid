{%- comment -%}
  Canister highlights — benefit row shown right under the buy box.
  Latitude 23.5 · accessory PDP template
{%- endcomment -%}
{%- style -%}
  #cn-hl-{{ section.id }} {
    background: {{ section.settings.bg }};
    color: {{ section.settings.text }};
    padding: {{ section.settings.pad_top }}px 20px {{ section.settings.pad_bottom }}px;
  }
  #cn-hl-{{ section.id }} .cn-wrap { max-width: 1200px; margin: 0 auto; }
  #cn-hl-{{ section.id }} h2 { font-size: clamp(22px, 2.4vw, 30px); margin: 0 0 28px; text-align: center; color: inherit; }
  #cn-hl-{{ section.id }} .cn-hl__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 16px;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, minmax(0, 1fr));
  }
  #cn-hl-{{ section.id }} .cn-hl__item {
    background: {{ section.settings.card_bg }};
    border-radius: 14px; padding: 22px 18px; text-align: center;
  }
  #cn-hl-{{ section.id }} .cn-hl__icon { width: 44px; height: 44px; margin: 0 auto 12px; color: {{ section.settings.accent }}; }
  #cn-hl-{{ section.id }} .cn-hl__icon svg, #cn-hl-{{ section.id }} .cn-hl__icon img { width: 100%; height: 100%; object-fit: contain; }
  #cn-hl-{{ section.id }} h3 { font-size: 16px; margin: 0 0 6px; color: inherit; }
  #cn-hl-{{ section.id }} p { font-size: 14px; line-height: 1.5; margin: 0; opacity: .85; }
  @media (max-width: 749px) {
    #cn-hl-{{ section.id }} .cn-hl__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    #cn-hl-{{ section.id }} .cn-hl__item { padding: 18px 12px; }
  }
{%- endstyle -%}

<section id="cn-hl-{{ section.id }}" class="cn-hl">
  <div class="cn-wrap">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <ul class="cn-hl__grid">
      {%- for block in section.blocks -%}
        <li class="cn-hl__item" {{ block.shopify_attributes }}>
          <div class="cn-hl__icon" aria-hidden="true">
            {%- if block.settings.custom_icon != blank -%}
              {{ block.settings.custom_icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {%- render 'canister-icon', name: block.settings.icon -%}
            {%- endif -%}
          </div>
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Canister highlights",
  "tag": "div",
  "class": "section-canister-highlights",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to keep coffee tasting like coffee" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F8F5EC" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#F3E7CF" },
    { "type": "color", "id": "text", "label": "Text", "default": "#2B1208" },
    { "type": "color", "id": "accent", "label": "Icon color", "default": "#2F5D3A" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 8,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "seal",
          "options": [
            { "value": "seal", "label": "Vacuum seal" },
            { "value": "light", "label": "Blocks light" },
            { "value": "release", "label": "One-touch release" },
            { "value": "beans", "label": "Coffee beans" },
            { "value": "leaf", "label": "Leaf / tea" },
            { "value": "globe", "label": "Globe" },
            { "value": "steel", "label": "Stainless steel" }
          ] },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon (overrides)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Press to seal" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "One press of the lid pushes air out." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Canister highlights",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "seal", "title": "Press to seal", "text": "One press of the lid pushes air out of the canister." } },
        { "type": "benefit", "settings": { "icon": "light", "title": "Blocks light", "text": "Opaque stainless steel keeps light away from your beans." } },
        { "type": "benefit", "settings": { "icon": "release", "title": "One-touch release", "text": "Tap the small button to release the vacuum and open." } },
        { "type": "benefit", "settings": { "icon": "beans", "title": "Beans, grounds or tea", "text": "Works for whole beans, ground coffee and loose-leaf tea." } }
      ]
    }
  ]
}
{% endschema %}
